{
  "name": "whatsapp-gateway-server",
  "version": "1.0.0",
  "description": "WhatsApp API Gateway — Express & PostgreSQL Backend with LangChain RAG",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@langchain/core": "^1.2.14",
    "@langchain/groq": "^0.1.3",
    "@prisma/client": "^6.7.0",
    "@whiskeysockets/baileys": "6.7.13",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jimp": "^0.22.12",
    "langchain": "^1.5.15",
    "mammoth": "^1.13.0",
    "pino": "^10.3.1",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.30",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
