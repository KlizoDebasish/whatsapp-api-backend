# =============================================================
# WhatsApp API Gateway — Express Backend Configuration
# =============================================================

# Server
PORT=4000
NODE_ENV=development

# =============================================================
# PostgreSQL (via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# =============================================================
DATABASE_URL="postgresql://wa_user:wa_password@localhost:5432/whatsapp_gateway"

# =============================================================
# CORS — Frontend origin(s) allowed to call this backend
# Comma-separated list
# =============================================================
ALLOWED_ORIGINS="http://localhost:3000"

# =============================================================
# Webhook Configuration
# =============================================================
WEBHOOK_URL=
WEBHOOK_NAME="Main Backend Webhook"
WEBHOOK_SECRET=

# =============================================================
# Google Gemini API & RAG Models (Google AI Studio Free Tier)
# =============================================================
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# =============================================================
# Groq LLM (LangChain ChatGroq) for RAG Response Generation
# =============================================================
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# =============================================================
# Security
# =============================================================
# Internal dashboard bypass header value (dashboard sends this)
DASHBOARD_SECRET=changeme_internal_dashboard_secret
